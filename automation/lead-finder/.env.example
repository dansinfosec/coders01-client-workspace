# Copy this file to `.env` and fill in your key. `.env` is gitignored — never commit it.
# Enable the "Places API (New)" for this key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Brave Search API subscription token — used ONLY by the website-discovery
# enrichment phase (leadfinder/website_discovery.py). Leave blank until you run
# real discovery; mock/dry-run runs never read it. Never commit the real value.
BRAVE_SEARCH_API_KEY=
