# BM Carservice — frontend environment (example, no secrets)
# The appointment form is frontend-only for now. When a backend/endpoint exists,
# point this at it. Never put private keys in a Vite frontend (VITE_* is public).

# Endpoint that receives the appointment form POST (e.g. a serverless function / form service).
VITE_APPOINTMENT_ENDPOINT=

# Optional: Google Maps embed / place id for the contact map.
VITE_MAPS_EMBED_URL=
